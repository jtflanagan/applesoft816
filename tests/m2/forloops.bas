10 FOR I=1 TO 2 STEP .1:PRINT I;" ";:NEXT I:PRINT
20 FOR I=10 TO 1 STEP -2.5:PRINT I;",";:NEXT:PRINT
30 FOR I=1 TO 3:FOR J=I TO 3:PRINT I*10+J;" ";:NEXT J,I:PRINT
40 FOR I=5 TO 1:PRINT "ONCE ";I:NEXT
50 FOR I=1 TO 3:FOR I=1 TO 2:PRINT "I";I;" ";:NEXT:NEXT:PRINT
60 FOR K=0 TO 1 STEP 0.3333333:PRINT K;" ";:NEXT:PRINT
70 FOR K=1 TO 0 STEP 0:PRINT K:IF K<3 THEN K=K+1:NEXT
80 S=0:FOR I=1 TO 1000:S=S+1/I:NEXT:PRINT S
90 PRINT "END ";I;" ";J;" ";K
