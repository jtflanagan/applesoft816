10 DIM A(5),B(2,3)
20 FOR I=0 TO 5:A(I)=I*I/3:NEXT
30 FOR I=0 TO 2:FOR J=0 TO 3:B(I,J)=I*10+J:NEXT J,I
40 FOR I=5 TO 0 STEP -1:PRINT A(I);" ";:NEXT:PRINT
50 FOR J=0 TO 3:FOR I=0 TO 2:PRINT B(I,J);" ";:NEXT I,J:PRINT
60 C(3)=7:C(10)=C(3)*2:PRINT C(10);" ";C(0);" ";C(3)
70 X=2:A(X+1)=A(X)+A(X*2):PRINT A(3)
80 PRINT A(6)
