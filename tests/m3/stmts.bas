10 FOR I=0 TO 4:ON I GOTO 20,30,40:PRINT "NONE";I:GOTO 50
20 PRINT "ONE";:GOTO 50
30 PRINT "TWO";:GOTO 50
40 PRINT "THREE";
50 NEXT:PRINT
60 FOR I=1 TO 3:ON I GOSUB 200,210,220:NEXT:PRINT
70 DEF FN SQ(X)=X*X+1:DEF FN CU(X)=FN SQ(X)*X:PRINT FN SQ(3);FN CU(2);X
80 X=5:PRINT FN SQ(X+1);X:DEF FN SQ(Y)=Y/2:PRINT FN SQ(9)
90 GOSUB 230:PRINT "POPPED"
100 POKE 768,42:PRINT PEEK(768);PEEK(768)+PEEK(769)
110 PRINT "AB";TAB(10);"C";SPC(3);"D";POS(0);TAB(2);"E"
120 HTAB 30:PRINT "H";:VTAB 20:HTAB 5:PRINT "V"
130 INVERSE:PRINT "INV";:NORMAL:PRINT "NORM"
140 SPEED=100:PRINT "SLOW":SPEED=255
150 POKE 768,169:POKE 769,65:POKE 770,141:POKE 771,0:POKE 772,4:POKE 773,96:CALL 768
160 PRINT PEEK(1024)
170 A=5:B$="X":CLEAR:PRINT A;B$;"CLEARED"
180 TRACE:Q=1:NOTRACE:PRINT
190 STOP
200 PRINT "S1";:RETURN
210 PRINT "S2";:RETURN
220 PRINT "S3";:RETURN
230 GOSUB 240:PRINT "NOT HERE"
240 POP:RETURN
